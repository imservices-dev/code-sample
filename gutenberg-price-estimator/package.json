{
  "name": "price-estimator",
  "version": "1.0.0",
  "description": "A Gutenberg block that lets visitors estimate a subscription price from configurable packages, billing models and add-ons.",
  "license": "GPL-2.0-or-later",
  "private": true,
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "lint:js": "wp-scripts lint-js src tests/js tests/e2e",
    "lint:css": "wp-scripts lint-style \"src/**/*.scss\"",
    "format": "wp-scripts format src tests/js tests/e2e",
    "test": "wp-scripts test-unit-js --config jest.config.js",
    "plugin-zip": "wp-scripts plugin-zip",
    "wp-env": "wp-env",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:destroy": "wp-env destroy",
    "test:e2e": "wp-scripts test-playwright --config tests/e2e/playwright.config.js",
    "test:all": "npm run lint:js && npm run lint:css && npm test && npm run build"
  },
  "files": [
    "price-estimator.php",
    "includes",
    "build",
    "readme.txt"
  ],
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@wordpress/block-editor": "^14.0.0",
    "@wordpress/blocks": "^13.0.0",
    "@wordpress/components": "^28.0.0",
    "@wordpress/e2e-test-utils-playwright": "^1.54.0",
    "@wordpress/element": "^6.0.0",
    "@wordpress/env": "^10.39.0",
    "@wordpress/i18n": "^5.0.0",
    "@wordpress/scripts": "^30.0.0",
    "typescript": "^5.9.3"
  }
}
