# ── Dependencies ──────────────────────────────────────────────────────────
node_modules/
vendor/
bower_components/

# ── Build output ──────────────────────────────────────────────────────────
# The Gutenberg block's compiled build/ IS committed on purpose, so the plugin
# installs on a server without Node. CI fails if it is out of date. Everything
# else generated is ignored.
dist/
out/
.next/
*.tsbuildinfo
coverage/
.nyc_output/

# ── Release artefacts ─────────────────────────────────────────────────────
*.zip
*.tar.gz

# ── Environment and secrets (never commit these) ──────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
auth.json
.wp-env.override.json

# ── Test and tooling caches ───────────────────────────────────────────────
.phpunit.result.cache
.phpcs.xml
phpcs.xml
phpunit.xml
.eslintcache
.stylelintcache
.cache/
.vite/
playwright-report/
test-results/
artifacts/

# ── Logs ──────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Editors and OS ────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~
